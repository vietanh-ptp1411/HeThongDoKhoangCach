<Window x:Class="BeltTensionMeasurement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BeltTensionMeasurement.ViewModels"
        xmlns:ctrl="clr-namespace:BeltTensionMeasurement.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Icon="/BeltTensionMeasurement;component/Assets/BeltTensionMeasurement.ico"
        Width="1600" Height="940" MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Giữ ảnh gốc; chỉ bỏ phần lề trắng thừa trong vùng hiển thị của logo. -->
        <BitmapImage x:Key="CompanyLogoSource" UriSource="/BeltTensionMeasurement;component/Assets/CompanyLogo.jpg" CacheOption="OnLoad"/>
        <CroppedBitmap x:Key="CompanyLogo" Source="{StaticResource CompanyLogoSource}" SourceRect="195,245,1370,405"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= TIÊU ĐỀ ================= -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" CornerRadius="6" Height="54" Margin="0,0,0,10">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="HeaderSide"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="HeaderSide"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Border Background="White" CornerRadius="4" Padding="4,3" VerticalAlignment="Center">
                        <Image Source="{StaticResource CompanyLogo}" Width="108" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="Logo đơn vị"/>
                    </Border>
                    <TextBlock Text="{Binding CompanyLabel}" Foreground="White" FontSize="13.5" FontWeight="SemiBold" MaxWidth="140"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding CompanyLabel}"/>
                </StackPanel>
                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" Height="30" Margin="8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="Bold" TextAlignment="Center"/>
                </Viewbox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Style="{StaticResource HeaderPill}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCalendar}" Style="{StaticResource IconStroke}" Stroke="White" Width="15" Height="15"/>
                            <TextBlock Text="{Binding Now, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource HeaderPill}" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconClock}" Style="{StaticResource IconStroke}" Stroke="White" Width="15" Height="15"/>
                            <TextBlock Text="{Binding Now, StringFormat='{}{0:HH:mm:ss}'}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>


                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= THÂN ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10,6">
                    <StackPanel>
                        <Border Background="#D5EAF5" CornerRadius="3" Padding="6,2" Margin="0,0,0,4">
                            <TextBlock Text="THÔNG TIN ĐO" Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <Grid IsEnabled="{Binding CanEditSelection}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Quy cách" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="SpecBox" Grid.Column="1" ItemsSource="{Binding Specs}" SelectedItem="{Binding SelectedSpec}" DisplayMemberPath="Name" Height="24" Margin="0,0,0,2"/>
                            <TextBlock Grid.Row="1" Text="Dòng hàng" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ModelBox" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Name" Height="24" Margin="0,0,0,2" ToolTip="Model thuộc quy cách đã chọn"/>
                            <TextBlock Grid.Row="2" Text="Số serial" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="QrBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldTextBox}" Height="26" Margin="0,0,0,2"
                                     Text="{Binding SerialInput, UpdateSourceTrigger=PropertyChanged}" PreviewMouseLeftButtonDown="ScanBox_PreviewMouseLeftButtonDown" GotKeyboardFocus="ScanBox_GotKeyboardFocus"
                                     ToolTip="Bấm ô để quét hoặc nhập Serial. Có thể bấm START ngay sau khi nhập đủ thông tin, không cần Enter."/>
                            <TextBlock Grid.Row="3" Text="MSNV" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="InspectorBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldTextBox}" Height="26" Margin="0,0,0,2"
                                     Text="{Binding InspectorInput, UpdateSourceTrigger=PropertyChanged}" PreviewMouseLeftButtonDown="ScanBox_PreviewMouseLeftButtonDown" GotKeyboardFocus="ScanBox_GotKeyboardFocus"
                                     ToolTip="Bấm ô để quét hoặc nhập MSNV. Có thể bấm START ngay sau khi nhập đủ thông tin, không cần Enter."/>
                        </Grid>
                        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4" Margin="0,4,0,0" IsEnabled="{Binding CanEditSelection}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="MỤC ĐÍCH ĐO CỦA SẢN PHẨM" Style="{StaticResource SectionTitle}" FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ComboBox x:Name="PurposeBox" ItemsSource="{Binding Purposes}" SelectedItem="{Binding SelectedPurpose}" DisplayMemberPath="DisplayName" Height="24" ToolTip="Chọn mục đích hoặc quét barcode 1–5"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,3,0,0" IsEnabled="{Binding CanEditSelection}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Quét mục đích (1–5)" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                            <TextBox x:Name="PurposeScanBox" Grid.Column="1" Style="{StaticResource FieldTextBox}" Height="26" Text="{Binding PurposeInput, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewMouseLeftButtonDown="ScanBox_PreviewMouseLeftButtonDown" GotKeyboardFocus="ScanBox_GotKeyboardFocus" ToolTip="Bấm vào ô này rồi quét mục đích; hoặc chọn danh sách phía trên"/>
                        </Grid>
                        <TextBlock Text="{Binding ScanHint}" Foreground="#C0392B" TextWrapping="Wrap" Height="28" FontSize="11.5" Margin="0,2,0,0" ToolTip="{Binding ScanHint}"/>
                        <UniformGrid Columns="3" Margin="0,4,0,0">
                            <Button Content="START" Style="{StaticResource StartButton}" Command="{Binding StartCommand}" Height="30" FontSize="11" Margin="0,0,4,0" ToolTip="{Binding ScanHint}" ToolTipService.ShowOnDisabled="True"/>
                            <Button Content="STOP" Style="{StaticResource StopButton}" Command="{Binding StopCommand}" Height="30" Margin="4,0"/>
                            <Button Content="RESET" Style="{StaticResource ResetButton}" Command="{Binding ResetCommand}" Height="30" Margin="4,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,6,0,0" Padding="8,5">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Kết quả đo (mm)" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                            <Viewbox Height="45" Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock FontSize="40" FontWeight="Bold" Foreground="{StaticResource ValueBrush}"><Run Text="{Binding MeasuredValueText, Mode=OneWay}"/><Run Text=" mm"/></TextBlock>
                            </Viewbox>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Viewbox Margin="8" Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock Text="{Binding JudgeText}" FontSize="70" FontFamily="Georgia" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding JudgeState}" Value="Pass"><Setter Property="Foreground" Value="#082D72"/></DataTrigger>
                                                <DataTrigger Binding="{Binding JudgeState}" Value="Ng"><Setter Property="Foreground" Value="{StaticResource NgTextBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding JudgeState}" Value="Waiting"><Setter Property="Foreground" Value="{StaticResource MeasuringTextBrush}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Viewbox>
                            <Border Grid.Column="1" BorderBrush="#235CC1" BorderThickness="3" Background="White" Padding="2" MaxWidth="210" MaxHeight="210">
                                <ctrl:QrCodeControl x:Name="ResultQr" Text="{Binding ResultQrText}" ToolTip="{Binding ResultQrText}"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"><Run Text="Lực căng: "/><Run Text="{Binding ForceText, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding ForceUnit, Mode=OneWay}"/></TextBlock>
                            <TextBlock Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis"><Run Text="Khoảng cách: "/><Run Text="{Binding DistanceText, Mode=OneWay}"/><Run Text=" mm"/></TextBlock>
                        </Grid>
                    </Grid>
                </Border>
                <UniformGrid Grid.Row="2" Columns="2" Margin="0,8,0,0">
                    <Button Content="XUẤT PDF" Style="{StaticResource ToolButton}" Command="{Binding ExportPdfCommand}" Margin="0,0,4,0" ToolTip="Xuất các kết quả theo bộ lọc ngày hiện tại ra PDF, kèm QR"/>
                    <Button Content="XUẤT EXCEL" Style="{StaticResource ToolButton}" Command="{Binding ExportCommand}" Margin="4,0,0,0"/>
                </UniformGrid>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="270"/><RowDefinition Height="*" MinHeight="200"/></Grid.RowDefinitions>
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding HistogramGroups}" Margin="0,0,-8,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistogramGroupViewModel}">
                                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                        <ctrl:HistogramControl Grid.Row="1" Margin="0,6,0,0"
                                                               Values="{Binding Values}" Lsl="{Binding Lsl}" Usl="{Binding Usl}" SpecText="{Binding SpecText}"
                                                               BinCount="{Binding DataContext.HistogramBins, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Path Data="{StaticResource IconTable}" Style="{StaticResource IconStroke}" Width="16" Height="16"/>
                                <TextBlock Text="KẾT QUẢ GẦN NHẤT" Style="{StaticResource CardTitle}" Margin="8,0,0,0"/>
                                <TextBlock Text="(xuất ExportResultData – Excel)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconFilter}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Từ ngày" Style="{StaticResource FilterLabel}"/>
                                    <DatePicker x:Name="FromDatePicker" SelectedDate="{Binding FromDate}" Width="96" Height="26" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Đến ngày" Style="{StaticResource FilterLabel}"/>
                                    <DatePicker x:Name="ToDatePicker" SelectedDate="{Binding ToDate}" Width="96" Height="26" FontSize="12" Margin="0,0,6,0"/>
                                    <Button Content="Hôm nay" Style="{StaticResource SmallButton}" Padding="8,0" Command="{Binding FilterTodayCommand}" Height="26" Margin="0,0,4,0"/>
                                    <Button Content="7 ngày" Style="{StaticResource SmallButton}" Padding="8,0" Command="{Binding FilterWeekCommand}" Height="26" Margin="0,0,4,0"/>
                                    <Button Content="30 ngày" Style="{StaticResource SmallButton}" Padding="8,0" Command="{Binding FilterMonthCommand}" Height="26" Margin="0,0,4,0"/>
                                    <Button Content="Tất cả" Style="{StaticResource SmallButton}" Padding="8,0" Command="{Binding FilterAllCommand}" Height="26"/>
                                </WrapPanel>
                                <Border Grid.Column="1" Background="{StaticResource FieldBgBrush}" CornerRadius="4" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="12" Foreground="{StaticResource ValueBrush}"><Run Text="Tổng "/><Run Text="{Binding TotalText, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                                        <TextBlock FontSize="12" Foreground="{StaticResource StatusGreenBrush}" Margin="14,0,0,0"><Run Text="OK "/><Run Text="{Binding OkText, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                                        <TextBlock FontSize="12" Foreground="{StaticResource StatusRedBrush}" Margin="14,0,0,0"><Run Text="NG "/><Run Text="{Binding NgText, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <DataGrid Grid.Row="1" Style="{StaticResource ResultGrid}" ItemsSource="{Binding RecentRows}" Margin="0,8,0,0"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="False" RowHeight="28" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No" Binding="{Binding No}" Width="55"/>
                                <DataGridTextColumn Header="Chủng loại" Binding="{Binding Model}" Width="0.9*"/>
                                <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="1.3*"/>
                                <DataGridTextColumn Header="Quy cách" Binding="{Binding SpecText}" Width="0.8*"/>
                                <DataGridTextColumn Header="Lực căng" Binding="{Binding Force, StringFormat={}{0:0.00}}" Width="0.8*"/>
                                <DataGridTextColumn Header="Giá trị (mm)" Binding="{Binding Value, StringFormat={}{0:0.00}}" Width="0.9*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Kết quả" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource NgCellBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource OkCellBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ResultText}" FontWeight="Bold" FontSize="11.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource NgCellTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource OkCellTextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ngày kiểm tra" Binding="{Binding InspectedAt, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="1.2*"/>
                                <DataGridTextColumn Header="Mục đích đo" Binding="{Binding Purpose}" Width="1.5*"/>
                                <DataGridTextColumn Header="Người KT" Binding="{Binding Inspector}" Width="0.8*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Text="{Binding FilterSummary}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= THANH TRẠNG THÁI ================= -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.ToolTip>
                        <ToolTip><StackPanel>
                            <TextBlock Text="{Binding ConnectionText}"/>
                            <TextBlock Text="{Binding VersionText}" Margin="0,4,0,0"/>
                        </StackPanel></ToolTip>
                    </StackPanel.ToolTip>
                    <Ellipse Width="9" Height="9" Margin="0,0,7,0">
                        <Ellipse.Style><Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource StatusRedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PlcActive}" Value="True"><Setter Property="Fill" Value="#E4A024"/></DataTrigger>
                                <DataTrigger Binding="{Binding PlcOnline}" Value="True"><Setter Property="Fill" Value="{StaticResource StatusGreenBrush}"/></DataTrigger>
                            </Style.Triggers>
                        </Style></Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource ValueBrush}">
                        <Run Text="{Binding PlcLabel, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding PlcStatusText, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Style="{StaticResource StatusButton}" Content="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}"
                            Margin="8,0,0,0" MinWidth="55" ToolTip="Kết nối hoặc ngắt kết nối PLC" AutomationProperties.Name="Kết nối hoặc ngắt PLC"/>
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,0,0,0" Margin="12,0,0,0" Padding="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="Loadcell: "/><Run Text="{Binding LoadcellStatusText, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </Border>
                <TextBlock Grid.Column="2" Margin="14,0,0,0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center">
                    <Run Text="Máy: "/><Run Text="{Binding MachineStateText, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Grid.Column="3" Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="18,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>
                <Border Grid.Column="4" Background="White" CornerRadius="4" Padding="2,3,6,3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SmallButton}" Height="30" FontSize="11.5" Margin="6,0,0,0" Padding="10,0" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="CÀI ĐẶT" ToolTip="Cài đặt kết nối PLC, bảng địa chỉ, chủng loại, mã QR">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconGear}" Style="{StaticResource IconFill}" Fill="{StaticResource ValueBrush}" Width="14" Height="14"/>
                                <TextBlock Text="CÀI ĐẶT" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallButton}" Height="30" FontSize="11.5" Margin="6,0,0,0" Padding="10,0" Command="{Binding OpenStatisticsCommand}" AutomationProperties.Name="THỐNG KÊ" ToolTip="Thống kê OK/NG, trung bình, Cpk theo chủng loại và quy cách">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconBars}" Style="{StaticResource IconFill}" Fill="{StaticResource ValueBrush}" Width="14" Height="14"/>
                            <TextBlock Text="THỐNG KÊ" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallButton}" Height="30" FontSize="11.5" Margin="6,0,0,0" Padding="10,0" Command="{Binding OpenReportCommand}" AutomationProperties.Name="BÁO CÁO" ToolTip="Báo cáo chi tiết với bộ lọc theo ngày, chủng loại, kết quả">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconReport}" Style="{StaticResource IconStroke}" Stroke="{StaticResource ValueBrush}" Width="14" Height="14"/>
                            <TextBlock Text="BÁO CÁO" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
