<Window x:Class="HeThongDoKhoangCach.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HeThongDoKhoangCach.ViewModels"
        xmlns:ctrl="clr-namespace:HeThongDoKhoangCach.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Width="1600" Height="940" MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewTextInput="Window_PreviewTextInput">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= TIÊU ĐỀ ================= -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" CornerRadius="6" Height="54" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="18,0,12,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding CompanyLabel}" Foreground="White" Opacity="0.85" FontSize="12.5" FontStyle="Italic"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Border Style="{StaticResource HeaderPill}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCalendar}" Style="{StaticResource IconStroke}" Stroke="White" Width="15" Height="15"/>
                            <TextBlock Text="{Binding Now, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource HeaderPill}" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconClock}" Style="{StaticResource IconStroke}" Stroke="White" Width="15" Height="15"/>
                            <TextBlock Text="{Binding Now, StringFormat='{}{0:HH:mm:ss}'}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="26" Fill="#4A6FAA" Margin="14,0,8,0"/>

                    <Button Style="{StaticResource HeaderButton}" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="CÀI ĐẶT" ToolTip="Cài đặt kết nối PLC, bảng địa chỉ, chủng loại, mã QR">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconGear}" Style="{StaticResource IconFill}" Fill="White" Width="14" Height="14"/>
                            <TextBlock Text="CÀI ĐẶT" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding OpenStatisticsCommand}" AutomationProperties.Name="THỐNG KÊ" ToolTip="Thống kê OK/NG, trung bình, Cpk theo chủng loại và line">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconBars}" Style="{StaticResource IconFill}" Fill="White" Width="14" Height="14"/>
                            <TextBlock Text="THỐNG KÊ" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding OpenReportCommand}" AutomationProperties.Name="BÁO CÁO" ToolTip="Báo cáo chi tiết với bộ lọc theo line, chủng loại, kết quả">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconReport}" Style="{StaticResource IconStroke}" Stroke="White" Width="14" Height="14"/>
                            <TextBlock Text="BÁO CÁO" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding LoginCommand}" AutomationProperties.Name="ĐĂNG NHẬP" ToolTip="Đặt mã người kiểm tra">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconUser}" Style="{StaticResource IconStroke}" Stroke="White" Width="14" Height="14"/>
                            <TextBlock Text="ĐĂNG NHẬP" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= THÂN ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="THÔNG TIN ĐO" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <Grid IsEnabled="{Binding CanEditSelection}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="1. Quy cách" Style="{StaticResource FormLabel}"/>
                                <ComboBox Grid.Column="1" x:Name="SpecBox" ItemsSource="{Binding Specs}" SelectedItem="{Binding SelectedSpec}" DisplayMemberPath="Name" MinHeight="32" Margin="0,0,0,6" AutomationProperties.Name="Quy cách"/>
                                <TextBlock Grid.Row="1" Text="2. Chủng loại" Style="{StaticResource FormLabel}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ModelBox" ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Name" MinHeight="32" Margin="0,0,0,6" AutomationProperties.Name="Chủng loại"/>
                                <TextBlock Grid.Row="2" Text="3. Số serial" Style="{StaticResource FormLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="QrBox" Style="{StaticResource FieldTextBox}" Text="{Binding QrInput, UpdateSourceTrigger=PropertyChanged}" KeyDown="QrBox_KeyDown" ToolTip="{Binding QrPlaceholder}" AutomationProperties.Name="Scan serial"/>
                            </Grid>
                            <TextBlock Text="{Binding Serial, StringFormat=Serial: {0}}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <WrapPanel Margin="0,4">
                                <TextBlock Text="{Binding OrderNo, StringFormat=Đơn hàng: {0}}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Line, StringFormat=Line: {0}}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ConditionText}" Foreground="{StaticResource TextMutedBrush}" Margin="0,4"/>
                            <TextBlock Text="{Binding ScanHint}" Foreground="#C0392B" TextWrapping="Wrap" MinHeight="32" FontSize="12"/>
                            <UniformGrid Columns="3" Margin="0,8,0,0">
                                <Button Content="START" Style="{StaticResource StartButton}" Command="{Binding StartCommand}" Margin="0,0,4,0" AutomationProperties.Name="START"/>
                                <Button Content="STOP" Style="{StaticResource StopButton}" Command="{Binding StopCommand}" Margin="4,0" AutomationProperties.Name="STOP"/>
                                <Button Content="RESET" Style="{StaticResource ResetButton}" Command="{Binding ResetCommand}" Margin="4,0,0,0" AutomationProperties.Name="RESET"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="KẾT QUẢ ĐO (mm)" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding MeasuredValueText}" Style="{StaticResource BigValue}" FontSize="46" HorizontalAlignment="Center"/>
                            <ctrl:QrCodeControl x:Name="ResultQr" Text="{Binding ResultQrText}" Width="160" Height="160" HorizontalAlignment="Center" AutomationProperties.Name="QR kết quả"/>
                            <TextBlock Text="{Binding ResultQrText}" FontSize="11" MaxHeight="32" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" ToolTip="{Binding ResultQrText}"/>
                            <TextBlock Text="{Binding JudgeText}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding JudgeState}" Value="Pass"><Setter Property="Foreground" Value="{StaticResource PassTextBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding JudgeState}" Value="Ng"><Setter Property="Foreground" Value="{StaticResource NgTextBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding JudgeState}" Value="Waiting"><Setter Property="Foreground" Value="{StaticResource MeasuringTextBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <UniformGrid Columns="2">
                                <StackPanel><TextBlock Text="Lực căng"/><TextBlock Text="{Binding ForceText}" FontSize="18"/><TextBlock Text="{Binding ForceUnit}" FontSize="11"/></StackPanel>
                                <StackPanel><TextBlock Text="Khoảng cách"/><TextBlock Text="{Binding DistanceText}" FontSize="18"/><TextBlock Text="mm" FontSize="11"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
                <UniformGrid Grid.Row="1" Columns="2" Margin="0,8,0,0">
                    <Button Content="LƯU DỮ LIỆU" Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}" Margin="0,0,4,0"/>
                    <Button Content="XUẤT EXCEL" Style="{StaticResource ToolButton}" Command="{Binding ExportCommand}" Margin="4,0,0,0"/>
                </UniformGrid>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="270"/><RowDefinition Height="*" MinHeight="200"/></Grid.RowDefinitions>
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding HistogramGroups}" Margin="0,0,-8,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistogramGroupViewModel}">
                                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                        <ctrl:HistogramControl Grid.Row="1" Margin="0,6,0,0"
                                                               Values="{Binding Values}" Lsl="{Binding Lsl}" Usl="{Binding Usl}" SpecText="{Binding SpecText}"
                                                               BinCount="{Binding DataContext.HistogramBins, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Path Data="{StaticResource IconTable}" Style="{StaticResource IconStroke}" Width="16" Height="16"/>
                                <TextBlock Text="KẾT QUẢ GẦN NHẤT" Style="{StaticResource CardTitle}" Margin="8,0,0,0"/>
                                <TextBlock Text="(xuất ExportResultData – Excel)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <Path Data="{StaticResource IconFilter}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Từ ngày" Style="{StaticResource FilterLabel}"/>
                                <DatePicker x:Name="FromDatePicker" SelectedDate="{Binding FromDate}" Width="118" Height="28" FontSize="12" Margin="0,0,10,0"/>
                                <TextBlock Text="Đến ngày" Style="{StaticResource FilterLabel}"/>
                                <DatePicker x:Name="ToDatePicker" SelectedDate="{Binding ToDate}" Width="118" Height="28" FontSize="12" Margin="0,0,10,0"/>
                                <Button Content="Hôm nay" Style="{StaticResource SmallButton}" Command="{Binding FilterTodayCommand}" Height="28" Margin="0,0,4,0"/>
                                <Button Content="7 ngày" Style="{StaticResource SmallButton}" Command="{Binding FilterWeekCommand}" Height="28" Margin="0,0,4,0"/>
                                <Button Content="30 ngày" Style="{StaticResource SmallButton}" Command="{Binding FilterMonthCommand}" Height="28" Margin="0,0,4,0"/>
                                <Button Content="Tất cả" Style="{StaticResource SmallButton}" Command="{Binding FilterAllCommand}" Height="28"/>
                            </WrapPanel>
                        </StackPanel>

                        <DataGrid Grid.Row="1" Style="{StaticResource ResultGrid}" ItemsSource="{Binding RecentRows}" Margin="0,8,0,0"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="False" RowHeight="28" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No" Binding="{Binding No}" Width="55"/>
                                <DataGridTextColumn Header="Đơn hàng" Binding="{Binding OrderNo}" Width="1.1*"/>
                                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="0.7*"/>
                                <DataGridTextColumn Header="Chủng loại" Binding="{Binding Model}" Width="0.9*"/>
                                <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="1.3*"/>
                                <DataGridTextColumn Header="Quy cách" Binding="{Binding SpecText}" Width="0.8*"/>
                                <DataGridTextColumn Header="Lực căng" Binding="{Binding Force, StringFormat={}{0:0.00}}" Width="0.8*"/>
                                <DataGridTextColumn Header="Giá trị (mm)" Binding="{Binding Value, StringFormat={}{0:0.00}}" Width="0.9*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Kết quả" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource NgCellBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource OkCellBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ResultText}" FontWeight="Bold" FontSize="11.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource NgCellTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource OkCellTextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ngày kiểm tra" Binding="{Binding InspectedAt, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="1.2*"/>
                                <DataGridTextColumn Header="Người KT" Binding="{Binding Inspector}" Width="0.8*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Text="{Binding FilterSummary}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= THANH TRẠNG THÁI ================= -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,6" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StatusRedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlcOnline}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource StatusGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource StatusText}">
                        <Run Text="PLC:" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding PlcStatusText, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding ConnectCommand}" AutomationProperties.Name="KẾT NỐI PLC"
                            ToolTip="Kết nối / ngắt kết nối PLC (phần mềm đọc dữ liệu liên tục khi đã kết nối)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlug}" Style="{StaticResource IconStroke}" Stroke="{StaticResource ValueBrush}" Width="12" Height="12"/>
                            <TextBlock Text="{Binding ConnectButtonText}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Style="{StaticResource StatusSeparator}"/>
                    <Path Data="{StaticResource IconScale}" Style="{StaticResource IconStroke}" Stroke="{StaticResource ValueBrush}" Width="18" Height="18"/>
                    <TextBlock Style="{StaticResource StatusText}">
                        <Run Text="LOADCELL:" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding LoadcellStatusText, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>

                    <Rectangle Style="{StaticResource StatusSeparator}"/>
                    <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource NeutralIconBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MachineRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource StatusGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource StatusText}">
                        <Run Text="MÁY:" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding MachineStateText, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>

                    <Rectangle Style="{StaticResource StatusSeparator}"/>
                    <Path Data="{StaticResource IconPackage}" Style="{StaticResource IconStroke}" Stroke="{StaticResource ValueBrush}" Width="18" Height="18"/>
                    <TextBlock Style="{StaticResource StatusText}">
                        <Run Text="TOTAL:" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding TotalText, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>

                    <Rectangle Style="{StaticResource StatusSeparator}"/>
                    <Grid Width="18" Height="18" VerticalAlignment="Center">
                        <Ellipse Fill="{StaticResource StatusGreenBrush}"/>
                        <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="10" Height="10" Stretch="Uniform"/>
                    </Grid>
                    <TextBlock Style="{StaticResource StatusText}">
                        <Run Text="OK:" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding OkText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource StatusGreenBrush}"/>
                    </TextBlock>

                    <Rectangle Style="{StaticResource StatusSeparator}"/>
                    <Grid Width="18" Height="18" VerticalAlignment="Center">
                        <Ellipse Fill="{StaticResource StatusRedBrush}"/>
                        <Path Data="{StaticResource IconCross}" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
                    </Grid>
                    <TextBlock Style="{StaticResource StatusText}">
                        <Run Text="NG:" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding NgText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource StatusRedBrush}"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconUser}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="15" Height="15"/>
                    <TextBlock Text="{Binding InspectorText}" Style="{StaticResource StatusText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <Rectangle Style="{StaticResource StatusSeparator}"/>
                    <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource StatusText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0"/>
                    <Rectangle Style="{StaticResource StatusSeparator}"/>
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource StatusText}" FontWeight="SemiBold" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
