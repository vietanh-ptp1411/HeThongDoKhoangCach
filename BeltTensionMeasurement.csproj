<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>BeltTensionMeasurement</RootNamespace>
    <AssemblyName>BeltTensionMeasurement</AssemblyName>
    <ApplicationIcon>Assets\BeltTensionMeasurement.ico</ApplicationIcon>
    <Product>Belt Tension Measurement</Product>
    <Description>Belt tension measurement with PLC, loadcell and barcode scanning.</Description>
    <Version>1.2.1</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="PDFsharp-MigraDoc-WPF" Version="6.2.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Page Remove="Tests\**\*.xaml" />
    <None Remove="Data\master.csv" />
    <None Remove="Assets\BeltTensionMeasurement.ico" />
    <Resource Include="Assets\BeltTensionMeasurement.ico" />
    <None Remove="Assets\CompanyLogo.jpg" />
    <Resource Include="Assets\CompanyLogo.jpg" />
  </ItemGroup>

</Project>
