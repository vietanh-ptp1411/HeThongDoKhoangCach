<Window x:Class="HeThongDoKhoangCach.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HeThongDoKhoangCach.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:StatisticsViewModel}"
        Title="Thống kê kết quả kiểm tra" Width="1150" Height="700" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" FontSize="12.5">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10">
            <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource ValueBrush}" FontWeight="Bold" FontSize="13.5"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="THEO CHỦNG LOẠI" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                <DataGrid Grid.Row="1" Style="{StaticResource ResultGrid}" ItemsSource="{Binding ByModel}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Chủng loại" Binding="{Binding Key}" Width="1.2*"/>
                        <DataGridTextColumn Header="Nhóm" Binding="{Binding Group}" Width="1.3*"/>
                        <DataGridTextColumn Header="Quy cách" Binding="{Binding Spec}" Width="1*"/>
                        <DataGridTextColumn Header="Tổng" Binding="{Binding Total}" Width="0.6*"/>
                        <DataGridTextColumn Header="OK" Binding="{Binding Ok}" Width="0.6*"/>
                        <DataGridTextColumn Header="NG" Binding="{Binding Ng}" Width="0.6*"/>
                        <DataGridTextColumn Header="Tỉ lệ OK" Binding="{Binding OkRateText}" Width="0.8*"/>
                        <DataGridTextColumn Header="Trung bình" Binding="{Binding MeanText}" Width="0.8*"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding MinText}" Width="0.7*"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding MaxText}" Width="0.7*"/>
                        <DataGridTextColumn Header="Độ lệch chuẩn" Binding="{Binding StdDevText}" Width="0.9*"/>
                        <DataGridTextColumn Header="Cpk" Binding="{Binding CpkText}" Width="0.6*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="THEO LINE" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                <DataGrid Grid.Row="1" Style="{StaticResource ResultGrid}" ItemsSource="{Binding ByLine}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Line" Binding="{Binding Key}" Width="1.2*"/>
                        <DataGridTextColumn Header="Tổng" Binding="{Binding Total}" Width="0.7*"/>
                        <DataGridTextColumn Header="OK" Binding="{Binding Ok}" Width="0.7*"/>
                        <DataGridTextColumn Header="NG" Binding="{Binding Ng}" Width="0.7*"/>
                        <DataGridTextColumn Header="Tỉ lệ OK" Binding="{Binding OkRateText}" Width="0.9*"/>
                        <DataGridTextColumn Header="Trung bình" Binding="{Binding MeanText}" Width="0.9*"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding MinText}" Width="0.8*"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding MaxText}" Width="0.8*"/>
                        <DataGridTextColumn Header="Độ lệch chuẩn" Binding="{Binding StdDevText}" Width="1*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Button Grid.Row="3" Content="Đóng" Style="{StaticResource OutlineButton}" Width="110" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Close_Click"/>
    </Grid>
</Window>
