<Window x:Class="HeThongDoKhoangCach.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HeThongDoKhoangCach.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ReportViewModel}"
        Title="Báo cáo kết quả kiểm tra" Width="1360" Height="780" MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterOwner" WindowState="Maximized" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" FontSize="12.5">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FilterLabel">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style TargetType="StackPanel" x:Key="FilterField">
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bộ lọc -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Style="{StaticResource FilterField}">
                    <TextBlock Text="Từ ngày" Style="{StaticResource FilterLabel}"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Width="130" Height="30"/>
                </StackPanel>
                <StackPanel Style="{StaticResource FilterField}">
                    <TextBlock Text="Đến ngày" Style="{StaticResource FilterLabel}"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Width="130" Height="30"/>
                </StackPanel>
                <StackPanel Style="{StaticResource FilterField}">
                    <TextBlock Text="Line" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Width="120" Height="30"/>
                </StackPanel>
                <StackPanel Style="{StaticResource FilterField}">
                    <TextBlock Text="Chủng loại" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" Width="140" Height="30"/>
                </StackPanel>
                <StackPanel Style="{StaticResource FilterField}">
                    <TextBlock Text="Kết quả" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" Width="90" Height="30"/>
                </StackPanel>
                <StackPanel Style="{StaticResource FilterField}">
                    <TextBlock Text="Tìm kiếm (serial, dòng hàng, người KT, ghi chú)" Style="{StaticResource FilterLabel}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="260" Height="30" VerticalContentAlignment="Center" Padding="6,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,0">
                    <Button Content="Tìm" Style="{StaticResource PrimaryButton}" Height="30" Width="90" Command="{Binding ApplyCommand}"/>
                    <Button Content="Xóa lọc" Style="{StaticResource SmallButton}" Height="30" Width="90" Margin="8,0,0,0" Command="{Binding ClearCommand}"/>
                    <Button Style="{StaticResource StartButton}" Height="30" Width="110" Margin="8,0,0,0" Command="{Binding ExportCommand}" FontSize="12.5">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconUpload}" Style="{StaticResource IconStroke}" Stroke="White" Width="14" Height="14"/>
                            <TextBlock Text="Excel" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Lưới kết quả -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,10,0,0">
            <DataGrid Style="{StaticResource ResultGrid}" ItemsSource="{Binding Rows}" EnableRowVirtualization="True" EnableColumnVirtualization="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding No}" Width="55"/>
                    <DataGridTextColumn Header="Dòng hàng" Binding="{Binding OrderNo}" Width="1.1*"/>
                    <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="0.7*"/>
                    <DataGridTextColumn Header="Chủng loại" Binding="{Binding Model}" Width="0.9*"/>
                    <DataGridTextColumn Header="Mã quét (Serial)" Binding="{Binding Serial}" Width="1.4*"/>
                    <DataGridTextColumn Header="Hạng mục kiểm tra" Binding="{Binding ItemName}" Width="1.1*"/>
                    <DataGridTextColumn Header="Quy cách (mm)" Binding="{Binding SpecText}" Width="0.9*"/>
                    <DataGridTextColumn Header="Lực căng (gf)" Binding="{Binding Force, StringFormat={}{0:0.00}}" Width="0.9*"/>
                    <DataGridTextColumn Header="Giá trị (mm)" Binding="{Binding Value, StringFormat={}{0:0.00}}" Width="0.9*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Kết quả" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource NgCellBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource OkCellBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ResultText}" FontWeight="Bold" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource NgCellTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource OkCellTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Ngày kiểm tra" Binding="{Binding InspectedAt, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="1.2*"/>
                    <DataGridTextColumn Header="Người KT" Binding="{Binding Inspector}" Width="0.8*"/>
                    <DataGridTextColumn Header="Máy tính" Binding="{Binding PcName}" Width="0.9*"/>
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="1.3*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource ValueBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="Đóng" Style="{StaticResource OutlineButton}" Width="110" HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
